# =========================================================================
#  Zebra Camera TCP Tracking - Environment Configuration Template
# =========================================================================

# Target Enable / Disable Toggles
ENABLE_LOCAL_AUDIT=true        # Logs scan events to local CSV (logs/sql_audit.csv)
ENABLE_PRODUCTION=false        # Connects to Factory Production MS SQL Server

# Live Commit Toggle (Applies to Production MS SQL Server)
# ENABLE_LIVE_COMMIT=true  -> LIVE MODE: Commits rows permanently to SQL Server!
# ENABLE_LIVE_COMMIT=false -> SAFETY MODE: Executes SP with Transaction Rollback (0 rows saved)
ENABLE_LIVE_COMMIT=false

# Web UI Dashboard HTTP Port (8088 / 8080)
WEB_PORT=8088

# -------------------------------------------------------------------------
# Factory Production MS SQL Server Configuration
# -------------------------------------------------------------------------
PROD_SERVER=YOUR_SQL_SERVER_HOST
PROD_NAME=YOUR_DATABASE_NAME
PROD_USER=YOUR_DB_USER
PROD_PASSWORD=YOUR_DB_PASSWORD
PROD_DRIVER=ODBC Driver 17 for SQL Server
PROD_SP_NAME=csp_AutoProdChange_BY_TRED_CARD
